# Public client (safe to expose — RLS still protects rows)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: talk to the Node API instead of supabase-js
# VITE_API_URL=http://127.0.0.1:8787

# Server / Edge Functions only — never prefix these with VITE_
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OTP_PEPPER=change-this-to-a-long-random-string
ALLOW_DEV_OTP=1
PORT=8787

# Email Auth is the current login method. Supabase sends the OTP — no SMS provider needed.
# In Authentication → Email templates, use {{ .Token }} so the user gets a 6-digit code.

# Phone SMS later (optional)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
