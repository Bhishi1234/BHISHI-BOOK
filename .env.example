# Public client (safe to expose — RLS still protects rows)
# Vercel’s Supabase integration also provides SUPABASE_URL / SUPABASE_ANON_KEY.
# Vite now reads those. Prefer VITE_ copies if you set them by hand.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public app URL (Cashfree return also uses SITE_URL on Edge Functions)
VITE_APP_URL=http://localhost:5173

# Optional: talk to the Node API instead of supabase-js
# VITE_API_URL=http://127.0.0.1:8787

# Server / Edge Functions only — never prefix these with VITE_
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OTP_PEPPER=change-this-to-a-long-random-string
ALLOW_DEV_OTP=1
PORT=8787

# Cashfree Subscriptions (set via `supabase secrets set` — never commit real values)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=
CASHFREE_PLAN_PRO_MONTH=
CASHFREE_PLAN_PRO_YEAR=
CASHFREE_PLAN_POWER_MONTH=
CASHFREE_PLAN_POWER_YEAR=
SITE_URL=http://localhost:5173

# Email + password. Confirm email must be ON in Supabase Auth.
# Add the Vercel URL in Authentication → URL configuration.

# Phone SMS later (optional)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
